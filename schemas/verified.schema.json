{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "maxLength": 128,
    "pattern": "^[A-Za-z0-9_-]+$"
  },
  "additionalProperties": {
    "type": "array",
    "items": {
      "type": "string",
      "pattern": "^cue\\d{7}$"
    }
  },
  "title": "verified.json"
}
