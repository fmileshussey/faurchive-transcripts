{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "collection": {
        "type": "string",
        "minLength": 1
      },
      "sub": {
        "type": "string"
      },
      "date": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "year": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          {
            "type": "null"
          }
        ]
      },
      "durationSec": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "sourcePath": {
        "type": "string",
        "pattern": "^[^/].*\\.[A-Za-z0-9]+$"
      },
      "transcribed": {
        "type": "boolean"
      },
      "source": {
        "type": "object",
        "properties": {
          "archive": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "recordedBy": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "title",
      "collection",
      "sub",
      "date",
      "year",
      "durationSec",
      "sourcePath",
      "transcribed"
    ],
    "additionalProperties": false
  },
  "title": "catalog.json"
}
