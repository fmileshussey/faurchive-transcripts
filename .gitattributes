# The checker rejects CRLF in a transcript; this stops git from producing it.
*.vtt  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.ts   text eol=lf
*.py   text eol=lf

# generated — collapsed in PR diffs
schemas/*.schema.json linguist-generated=true
bun.lock              linguist-generated=true
